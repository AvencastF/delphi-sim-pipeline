# Proposal: full SM Born Bhabha with ISR; not precision BHWIDE equivalence.
# Render @ECM@, @SEED@, @EVENTS@ before execution. Cuts need physics approval.
model = SM
process bhabha = e1, E1 => e1, E1
sqrts = @ECM@ GeV
seed = @SEED@
beams = e1, E1 => isr
?isr_handler = true
$isr_handler_mode = "recoil"
?keep_beams = true
?keep_remnants = true
isr_mass = me
# Apply each cut to each outgoing species. A comma denotes a particle tuple,
# not the union of the electron and positron lists. Retest before enabling.
cuts = all 5 degree < Theta < 175 degree [e1]
   and all 5 degree < Theta < 175 degree [E1]
   and all E > 1 GeV [e1]
   and all E > 1 GeV [E1]
integrate (bhabha) { iterations = 5:20000, 3:50000 }
n_events = @EVENTS@
$sample = "events"
# Weighted output was verified in job 58759054. Preserve zero-trial rescaling.
?unweighted = false
sample_format = hepmc, lhef
simulate (bhabha)
